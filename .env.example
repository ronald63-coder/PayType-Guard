# --- PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=      # same value as PAYPAL_CLIENT_ID (public, used by the JS SDK)
PAYPAL_WEBHOOK_ID=                 # from the Sandbox webhook you register (needed for signature verification)

# --- AI (optional: the app falls back to deterministic templates without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Demo helpers ---
# Lets the UI inject simulated webhook events when no public webhook URL exists (local dev).
ALLOW_SIMULATION=true
PROFILE_SECRET=                    # long random string used to sign readiness links (change in production)
